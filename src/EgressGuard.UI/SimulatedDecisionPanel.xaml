<UserControl x:Class="EgressGuard.UI.SimulatedDecisionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Simulation decisions">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
        <StackPanel Margin="16" MinWidth="0">
            <Border Background="#163B35" BorderBrush="#45D1A3" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="SimulationHeading" Text="{Binding SimulationModeLabel}" FontSize="22" FontWeight="Bold"
                               Foreground="#62E6BA" Focusable="True" AutomationProperties.AutomationId="SimulationModeLabel"
                               AutomationProperties.Name="Simulation mode" />
                    <TextBlock Text="{Binding NonEnforcementCopy}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding SimulationStatus}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.AutomationId="SimulationStatus" AutomationProperties.Name="Simulation status"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Content="Refresh Simulation state" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="SimulationRefreshButton" AutomationProperties.Name="Refresh Simulation state"
                    AutomationProperties.HelpText="Reload the authorized snapshot and re-establish event continuity." />

            <TextBlock Text="Active decision prompts" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,6" />
            <ListBox x:Name="PromptList" ItemsSource="{Binding ActivePrompts}" SelectedItem="{Binding SelectedPrompt}"
                     MinHeight="74" MaxHeight="180" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.AutomationId="DecisionPromptList" AutomationProperties.Name="Active Simulation decision prompts">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding RedactedFileLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Foreground="#B9C8D6" TextWrapping="Wrap">
                                <Run Text="{Binding ApplicationIdentity, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Destination.Protocol, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Destination.Address, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Destination.RemotePort, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="#111A23" BorderBrush="#324557" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DecisionFileLabel}" TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="DecisionFileLabel" AutomationProperties.Name="Redacted file label" />
                    <TextBlock Text="{Binding DecisionFileVersion}" TextWrapping="Wrap" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionFileVersion" AutomationProperties.Name="File version metadata selector" />
                    <TextBlock Text="{Binding DecisionApplication}" TextWrapping="Wrap" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionApplication" AutomationProperties.Name="Exact application identity" />
                    <TextBlock Text="{Binding DecisionSubjectScope}" TextWrapping="Wrap" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionSubjectScope" AutomationProperties.Name="Exact process scope" />
                    <TextBlock Text="{Binding DecisionCollateralWarning}" TextWrapping="Wrap" Foreground="#FFD166" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionCollateralWarning" AutomationProperties.Name="Group collateral warning" />
                    <TextBlock Text="{Binding DecisionDestination}" TextWrapping="Wrap" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionDestination" AutomationProperties.Name="Exact destination and protocol" />
                    <TextBlock Text="{Binding DecisionDomainProvenance}" TextWrapping="Wrap" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionDomainProvenance" AutomationProperties.Name="Domain evidence provenance" />
                    <TextBlock Text="{Binding DecisionExistingFlowWarning}" TextWrapping="Wrap" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionExistingFlowWarning" AutomationProperties.Name="Existing flow limitation" />
                    <TextBlock Text="{Binding DecisionLimitation}" TextWrapping="Wrap" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionLimitation" AutomationProperties.Name="Simulation limitation" />
                    <TextBlock Text="{Binding DecisionExpiry}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5"
                               AutomationProperties.AutomationId="DecisionExpiry" AutomationProperties.Name="Decision expiry" />
                    <TextBlock Text="{Binding DecisionScopePreview}" TextWrapping="Wrap" Margin="0,8"
                               AutomationProperties.AutomationId="DecisionScopePreview" AutomationProperties.Name="Remembered scope preview" />
                    <WrapPanel KeyboardNavigation.TabNavigation="Continue">
                        <Button Content="Allow once" Command="{Binding AllowOnceCommand}"
                                AutomationProperties.AutomationId="AllowOnceButton" AutomationProperties.Name="Allow once in Simulation"
                                AutomationProperties.HelpText="Allow only the current exact Simulation challenge." />
                        <Button Content="Remember for 30 days" Command="{Binding Remember30DaysCommand}"
                                AutomationProperties.AutomationId="Remember30DaysButton" AutomationProperties.Name="Remember exact scope for 30 days in Simulation"
                                AutomationProperties.HelpText="Remember only the displayed exact file version, application, destination and protocol in RAM." />
                        <Button Content="Block current flow" Command="{Binding BlockCurrentFlowCommand}"
                                AutomationProperties.AutomationId="BlockCurrentFlowButton" AutomationProperties.Name="Block current flow in Simulation"
                                AutomationProperties.HelpText="Terminate only the current Simulation intent; this is not a persistent firewall block." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Reconnect-required notices" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,5" />
            <TextBlock Text="{Binding ReconnectRequiredNotice}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ReconnectRequiredNotice" AutomationProperties.Name="Simulation reconnect required notice" />

            <TextBlock Text="Remembered Simulation rules" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,5" />
            <DataGrid ItemsSource="{Binding RememberedRules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" IsReadOnly="True"
                      MinHeight="80" MaxHeight="190" AutomationProperties.AutomationId="RememberedRuleList" AutomationProperties.Name="Remembered Simulation rules">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding RedactedFileLabel, Mode=OneWay}" Width="2*" />
                    <DataGridTextColumn Header="Application" Binding="{Binding ApplicationIdentity, Mode=OneWay}" Width="2*" />
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination.Address, Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtUtc, Mode=OneWay}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="Revoke remembered Simulation rule" Command="{Binding RevokeRememberedRuleCommand}" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="RevokeRememberedRuleButton" AutomationProperties.Name="Revoke remembered Simulation rule"
                    AutomationProperties.HelpText="Revoke only the selected exact RAM-only Simulation rule at its displayed revision." />

            <Border Background="#4A2025" BorderBrush="#FF6B6B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,6">
                <TextBlock Text="{Binding CriticalFailOpenBanner}" TextWrapping="Wrap" FontWeight="Bold"
                           AutomationProperties.AutomationId="CriticalFailOpenBanner" AutomationProperties.Name="Critical Simulation fail-open alert"
                           AutomationProperties.LiveSetting="Assertive" />
            </Border>
            <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" Margin="0,5" AutomationProperties.LiveSetting="Polite" />

            <TextBlock Text="Recent Simulation gate status" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,5" />
            <ListBox ItemsSource="{Binding RecentStatuses}" MaxHeight="160" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Margin="4">
                            <Run Text="{Binding AuditTimeUtc, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ReasonCode, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
