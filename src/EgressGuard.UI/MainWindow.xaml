<Window x:Class="EgressGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EgressGuard.UI"
        Title="EgressGuard" Width="1180" Height="640" MinWidth="640" MinHeight="480"
        Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="EGRESSGUARD" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Local outbound visibility and control" Foreground="#8FA4B8" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12,7">
                <TextBlock Text="{Binding ServiceStatus}" />
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1" Background="{StaticResource PanelBrush}" Foreground="#E8EEF5">
            <TabItem Header="Dashboard">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Background="#202C38" CornerRadius="8" Margin="5" Padding="16"><StackPanel><TextBlock Text="Protection" Foreground="#8FA4B8"/><TextBlock Text="{Binding ProtectionMode}" FontSize="24"/></StackPanel></Border>
                        <Border Background="#202C38" CornerRadius="8" Margin="5" Padding="16"><StackPanel><TextBlock Text="Active connections" Foreground="#8FA4B8"/><TextBlock Text="{Binding ActiveCount}" FontSize="24"/></StackPanel></Border>
                        <Border Background="#202C38" CornerRadius="8" Margin="5" Padding="16"><StackPanel><TextBlock Text="Network processes" Foreground="#8FA4B8"/><TextBlock Text="{Binding ProcessCount}" FontSize="24"/></StackPanel></Border>
                        <Border Background="#202C38" CornerRadius="8" Margin="5" Padding="16"><StackPanel><TextBlock Text="Recent alerts" Foreground="#8FA4B8"/><TextBlock Text="{Binding AlertCount}" FontSize="24"/></StackPanel></Border>
                    </UniformGrid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FlowView}" AutoGenerateColumns="False" IsReadOnly="True" Background="#111A23" Foreground="#E8EEF5" RowBackground="#18212B" AlternatingRowBackground="#202C38" SelectedItem="{Binding SelectedFlow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="2*" />
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="*" />
                            <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="2*" />
                            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="*" />
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Live Connections">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search process, IP, or domain" />
                        <ComboBox Width="130" ItemsSource="{Binding ProtocolFilters}" SelectedItem="{Binding ProtocolFilter}" />
                        <ComboBox Width="130" ItemsSource="{Binding IpFilters}" SelectedItem="{Binding IpFilter}" />
                        <ComboBox Width="130" ItemsSource="{Binding RiskFilters}" SelectedItem="{Binding RiskFilter}" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FlowView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Background="#111A23" Foreground="#E8EEF5" RowBackground="#18212B" AlternatingRowBackground="#202C38" SelectedItem="{Binding SelectedFlow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="150" />
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="170" />
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90" />
                            <DataGridTextColumn Header="Local endpoint" Binding="{Binding Local}" Width="180" />
                            <DataGridTextColumn Header="Remote endpoint" Binding="{Binding Remote}" Width="180" />
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="150" />
                            <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}" Width="150" />
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="150" />
                            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Connection Detail">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22" MinWidth="0" DataContext="{Binding SelectedFlow}">
                    <TextBlock Text="Connection Detail" FontSize="22" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" Margin="0,4" />
                    <TextBlock Text="{Binding ExecutablePath}" TextWrapping="Wrap" Margin="0,4" />
                    <TextBlock Text="{Binding Hash}" TextWrapping="Wrap" Margin="0,4" />
                    <TextBlock Text="{Binding Signature}" TextWrapping="Wrap" ToolTip="{Binding Signature}" Margin="0,4" />
                    <TextBlock Text="{Binding Parent}" Margin="0,4" />
                    <TextBlock Text="{Binding Destination}" Margin="0,4" />
                    <TextBlock Text="{Binding Reasons}" TextWrapping="Wrap" Margin="0,12" />
                    <Separator Margin="0,12" />
                    <TextBlock Text="Related file activity" FontSize="19" FontWeight="SemiBold" Margin="0,4" />
                    <TextBlock Text="{Binding DataContext.FileSensorStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#B9C9D8" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <TextBlock Text="{Binding DataContext.FileCorrelationEmptyState, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#B9C9D8" TextWrapping="Wrap" Margin="0,4" />
                    <ListBox ItemsSource="{Binding DataContext.FileCorrelations, RelativeSource={RelativeSource AncestorType=Window}}"
                             MaxHeight="240" Background="#111A23" BorderBrush="#35485A"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#35485A" BorderThickness="0,0,0,1" Padding="8" ToolTip="{Binding ProtectedFileIdentifier}">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Operation}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding DisplayPath}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#B9C9D8" TextWrapping="Wrap">
                                            <Run Text="{Binding ActivityTimestampUtc}"/><Run Text=" · delta "/><Run Text="{Binding TimeDeltaSeconds, StringFormat={}{0:0.###} s}"/><Run Text=" · "/><Run Text="{Binding Confidence}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Reason}" Foreground="#B9C9D8" TextWrapping="Wrap" ToolTip="{Binding Reason}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Related activity does not prove that file contents were transmitted."
                               Foreground="#FFD166" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4" />
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Alerts">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutoGenerateColumns="False" IsReadOnly="True" Background="#111A23" Foreground="#E8EEF5">
                        <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding CreatedAt}" Width="160"/><DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="180"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="220"/><DataGridTextColumn Header="Score" Binding="{Binding Assessment.Score}" Width="80"/><DataGridTextColumn Header="Level" Binding="{Binding Assessment.Level}" Width="100"/><DataGridTextColumn Header="Decision" Binding="{Binding Assessment.Decision}" Width="100"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{Binding AlertReasonText}" TextWrapping="Wrap" Margin="4,12" />
                    <WrapPanel Grid.Row="2"><Button Content="Allow once" Command="{Binding AllowOnceCommand}"/><Button Content="Always allow" Command="{Binding AllowCommand}"/><Button Content="Block" Command="{Binding BlockCommand}"/><Button Content="Undo rule" Command="{Binding UndoRuleCommand}"/></WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Rules">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel><Button Content="Always allow selected" Command="{Binding AllowCommand}"/><Button Content="Block selected" Command="{Binding BlockCommand}"/><Button Content="Undo selected rule" Command="{Binding UndoRuleCommand}"/><Button Content="Reset owned rules" Command="{Binding ResetRulesCommand}"/></WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" IsReadOnly="True" Background="#111A23" Foreground="#E8EEF5">
                        <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="2*"/><DataGridTextColumn Header="Last match" Binding="{Binding LastMatchedAt}" Width="2*"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="24" Width="520" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" FontSize="22" Margin="0,0,0,14" />
                    <TextBlock Text="Protection mode"/><ComboBox ItemsSource="{Binding ProtectionModes}" SelectedItem="{Binding ProtectionMode}" />
                    <TextBlock Text="Refresh interval (milliseconds)"/><TextBox Text="{Binding RefreshIntervalMilliseconds}" />
                    <TextBlock Text="Retention (days)"/><TextBox Text="{Binding RetentionDays}" />
                    <TextBlock Text="Database"/><TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" Margin="4,8" />
                    <CheckBox Content="Enable notifications" IsChecked="{Binding NotificationsEnabled}" Foreground="#E8EEF5" Margin="4,12" />
                    <WrapPanel><Button Content="Apply mode" Command="{Binding ApplyModeCommand}"/><Button Content="Clear history" Command="{Binding ClearHistoryCommand}"/><Button Content="Reset baseline" Command="{Binding ResetBaselineCommand}"/></WrapPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Simulation Decisions" AutomationProperties.AutomationId="SimulationDecisionTab"
                     AutomationProperties.Name="Simulation decisions">
                <local:SimulatedDecisionPanel x:Name="SimulationDecisionPanel" />
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding LastOperation}" Foreground="#8FA4B8" Margin="2,10,2,0" />
    </Grid>
</Window>
